# Copy to .env and fill in. Never commit the real .env.

# LiveKit Cloud project (https://cloud.livekit.io -> project -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM: Claude Haiku 4.5 (Anthropic plugin)
ANTHROPIC_API_KEY=

# TTS: Rime Coda (Rime plugin) — use a key that is stable all week for the booth
RIME_API_KEY=

# STT is LiveKit Inference (deepgram/nova-3), keyless — no Deepgram key needed.
