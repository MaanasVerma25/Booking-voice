# Frontend + token server (this Node app). Copy to .env; never commit .env.
# Only LiveKit project credentials are needed here.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PORT=3000

# Google Apps Script Webhook URL for Google Calendar & Google Sheets booking integration
GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# The LiveKit agent has its own keys (LLM + Rime TTS): see agent/.env.example

